# Local demo only. Copy to .env; never commit .env.
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora_local_only
POSTGRES_DB=memora
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
# Host URLs for hybrid development; Compose overrides these inside containers.
DATABASE_URL=postgresql+psycopg://memora:memora_local_only@127.0.0.1:5432/memora
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
# 后端聊天模型配置；密钥不得进入前端。
# Copy to .env. Fill Key and model there; never put these in frontend/VITE_*.
LLM_PROVIDER=openai_compatible
# Gemini official compatibility endpoint; exact model access depends on your project.
LLM_MODEL=gemini-3.1-flash-lite
# Required: paste your real API key after '=' in the ignored local .env only.
LLM_API_KEY=
# API root, including /v1 if required; do NOT append /chat/completions.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Sent as max_tokens for Gemini compatibility (no max_completion_tokens field).
LLM_TOKEN_PARAMETER=max_tokens
LLM_MAX_OUTPUT_TOKENS=1024
# Conservative input budget measured as UTF-8 bytes plus message overhead.
LLM_CONTEXT_TOKEN_BUDGET=12000
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=120
# Only retry 429/502/503/504 before any output; never retry partial responses.
LLM_MAX_RETRIES=1
# Per-demo-user limit across conversations; prevents unbounded parallel calls.
LLM_MAX_CONCURRENT_REQUESTS=1
# 独立的后端 Embedding 配置；凭证不发送至前端。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
# API root only; do not append /embeddings.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Required pair: exact provider model ID AND its output dimension.
# Request 768 via dimensions; reject mismatched replies, never truncate silently.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Set false for models/providers that do not accept a dimensions request field;
# EMBEDDING_DIMENSIONS must still equal the actual returned vector length.
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1
EMBEDDING_BATCH_SIZE=8
# Private files: hybrid defaults to data/private; Compose uses a named volume.
STORAGE_ROOT=./data/private
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=100
PDF_MAX_TEXT_CHARS=1000000
PDF_PARSE_TIMEOUT_SECONDS=30
# Deterministic approximate token units (English words/CJK characters).
PDF_CHUNK_TOKENS=600
PDF_CHUNK_OVERLAP=100
PDF_MAX_CHUNKS=2000
INGEST_JOB_TIMEOUT_SECONDS=300
INGEST_MAX_ACTIVE_JOBS=1
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
# Tavily 搜索密钥，仅供后端读取；未使用时可留空。
SEARCH_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
DEMO_ALLOWED_RECIPIENTS=demo@example.test
# Gemini 3.1 Flash-Lite: minimal thinking; none is unsupported, not sent.
LLM_REASONING_EFFORT=minimal
# Respect Retry-After/RetryInfo only up to this wait; longer hints require manual retry.
PROVIDER_RETRY_MAX_WAIT_SECONDS=15
# L2 normalize returned vectors; part of index identity, requires explicit rebuild.
EMBEDDING_NORMALIZE=true
# Conservative UTF-8 byte guard below gemini-embedding-001's 2048-token input cap.
# Applied to queries and chunk splitting; not a provider request field/tokenizer.
EMBEDDING_MAX_INPUT_BYTES=1800
# Redis slots shared between local/container API and workers, per embedding profile.
EMBEDDING_MAX_CONCURRENT_REQUESTS=1
# Minimum start spacing for cache misses; batching is input[] in one sync HTTP call.
EMBEDDING_MIN_INTERVAL_SECONDS=4
# Private hashed-key vector cache, no raw text; retries reuse successful batches.
EMBEDDING_CACHE_TTL_SECONDS=86400
# 会议 TXT 提取；内容发送给已配置的后端模型。
MEETING_MAX_UPLOAD_BYTES=65536
MEETING_MAX_INPUT_BYTES=8000
MEETING_MAX_OUTPUT_TOKENS=3000
# One schema/evidence repair at most; no automatic job replay.
MEETING_REPAIR_ATTEMPTS=1
# disabled: no sending; local: Mailpit/loopback + .test/.invalid recipients only.
# external additionally requires TLS, allowlist and explicit per-draft approval.
SMTP_MODE=local
# Host backend uses SMTP_HOST above. Compose uses this internal hostname.
SMTP_DOCKER_HOST=mailpit
SMTP_FROM=memora@example.test
SMTP_SECURITY=none
SMTP_TIMEOUT_SECONDS=10
# Keep false until the owner explicitly authorizes configuring external delivery.
SMTP_EXTERNAL_SEND_ENABLED=false
# Optional local Mailpit ports; start with --profile mail (no relay configured).
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Tavily 搜索配置，仅供后端使用。
# SEARCH_API_KEY is defined once above (line 66). Fill it locally.
# Official Tavily endpoint. A trusted custom/test endpoint may be injected.
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
# Private per-user query cache; original retrieved_at is retained on a hit.
SEARCH_CACHE_TTL_SECONDS=300
# Applied to structured outline requests, retains existing Gemini admission/retries.
PRESENTATION_MAX_OUTPUT_TOKENS=6000
PRESENTATION_JOB_TIMEOUT_SECONDS=240
PRESENTATION_CONVERSION_TIMEOUT_SECONDS=90
# Local hybrid development requires Node dependencies and LibreOffice + CJK fonts.
PRESENTATION_NODE=node
PRESENTATION_LIBREOFFICE=libreoffice
