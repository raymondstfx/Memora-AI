# Local demo only. Copy to .env; never commit .env.
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora_local_only
POSTGRES_DB=memora
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
# Host URLs for hybrid development; Compose overrides these inside containers.
DATABASE_URL=postgresql+psycopg://memora:memora_local_only@127.0.0.1:5432/memora
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
# Phase 1: backend-only OpenAI-compatible Chat Completions configuration.
# Copy to .env. Fill Key and model there; never put these in frontend/VITE_*.
LLM_PROVIDER=openai_compatible
# Required: replace with an exact chat model ID supported by your provider/account.
LLM_MODEL=your-model-id
# Required: paste your real API key after '=' in the ignored local .env only.
LLM_API_KEY=
# API root, including /v1 if required; do NOT append /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
# For providers requiring legacy max_tokens, change the next variable accordingly.
LLM_TOKEN_PARAMETER=max_completion_tokens
LLM_MAX_OUTPUT_TOKENS=1024
# Conservative input budget measured as UTF-8 bytes plus message overhead.
LLM_CONTEXT_TOKEN_BUDGET=12000
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=120
# Only retry 429/502/503/504 before any output; never retry partial responses.
LLM_MAX_RETRIES=1
# Per-demo-user limit across conversations; prevents unbounded parallel calls.
LLM_MAX_CONCURRENT_REQUESTS=2
# Phase 2: separate backend Embedding credentials, never sent to the frontend.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
# API root only; do not append /embeddings.
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Required pair: exact provider model ID AND its output dimension.
# 0/your-model-id are placeholders and deliberately disable embedding success.
EMBEDDING_MODEL=your-embedding-model-id
EMBEDDING_DIMENSIONS=0
# Set false for models/providers that do not accept a dimensions request field;
# EMBEDDING_DIMENSIONS must still equal the actual returned vector length.
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1
EMBEDDING_BATCH_SIZE=16
# Private files: hybrid defaults to data/private; Compose uses a named volume.
STORAGE_ROOT=./data/private
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=100
PDF_MAX_TEXT_CHARS=1000000
PDF_PARSE_TIMEOUT_SECONDS=30
# Deterministic approximate token units (English words/CJK characters).
PDF_CHUNK_TOKENS=600
PDF_CHUNK_OVERLAP=100
PDF_MAX_CHUNKS=2000
INGEST_JOB_TIMEOUT_SECONDS=300
INGEST_MAX_ACTIVE_JOBS=3
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
# Reserved for later phases; unused in Phase 2.
SEARCH_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEMO_ALLOWED_RECIPIENTS=
