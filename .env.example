# Local demo only. Copy to .env; never commit .env.
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora_local_only
POSTGRES_DB=memora
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=5173
# Host URLs for hybrid development; Compose overrides these inside containers.
DATABASE_URL=postgresql+psycopg://memora:memora_local_only@127.0.0.1:5432/memora
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEPENDENCY_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
# Reserved server-side configuration for later phases; unused in Phase 0.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
SEARCH_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEMO_ALLOWED_RECIPIENTS=
