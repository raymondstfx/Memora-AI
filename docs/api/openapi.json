{
  "openapi": "3.1.0",
  "info": {
    "title": "Memora AI API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "infrastructure"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Dependencies": {
        "properties": {
          "postgres": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Postgres"
          },
          "pgvector": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Pgvector"
          },
          "schema": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Schema"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Redis"
          }
        },
        "type": "object",
        "required": [
          "postgres",
          "pgvector",
          "schema",
          "redis"
        ],
        "title": "Dependencies"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "memora-api",
            "title": "Service",
            "default": "memora-api"
          },
          "version": {
            "type": "string",
            "const": "0.1.0",
            "title": "Version",
            "default": "0.1.0"
          },
          "dependencies": {
            "$ref": "#/components/schemas/Dependencies"
          }
        },
        "type": "object",
        "required": [
          "dependencies"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
